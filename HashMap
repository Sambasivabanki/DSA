import java.util.HashMap;
class Main
{
    public static void main(String[] args)
    {
        HashMap <Integer,Integer> h1=new HashMap<>();
        int[] arr={1,5,8,0,1,8,1,5,1};
        for(int i=0;i<arr.length;i++)
        {
            int n=arr[i];
            if(h1.containsKey(n))
            {
                int prev=h1.get(n);
                h1.put(n,prev+1);
            }
            else
            {
                h1.put(n,1);
            }
        }
        for(int i:h1.keySet())
        {
            System.out.println(i+" --> "+h1.get(i));
        }
    }
}
